{
    "name": "happy-desktop-workspace",
    "version": "0.0.47",
    "private": true,
    "description": "Happy local desktop client for Rig",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/slopus/happy2.git"
    },
    "type": "module",
    "scripts": {
        "dev": "pnpm dev:desktop",
        "dev:web": "pnpm exec portless run --name happy-desktop-web node scripts/dev-web.mjs",
        "dev:desktop": "node scripts/dev-desktop.mjs",
        "dev:desktop:electron": "node scripts/dev-desktop.mjs",
        "desktop:assets": "node scripts/create-mac-icon.mjs",
        "desktop:update-manifest": "node scripts/create-mac-update-manifest.mjs",
        "desktop:mac:release": "node scripts/build-mac-apps.mjs",
        "desktop:local:web": "pnpm --dir packages/happy-desktop-electron build:local-web-ui",
        "blueprint": "pnpm exec portless run --name happy-desktop-blueprint node scripts/dev-blueprint.mjs",
        "build": "pnpm -r --if-present build",
        "test": "pnpm -r --if-present test",
        "test:watch": "pnpm -r --parallel --if-present test:watch",
        "typecheck": "tsc --project tsconfig.json && pnpm -r --if-present typecheck",
        "format": "oxfmt --write eslint scripts tsconfig.json && pnpm -r --if-present format",
        "format:check": "oxfmt --check eslint scripts tsconfig.json && pnpm -r --if-present format:check",
        "lint": "oxlint eslint scripts && pnpm -r --if-present lint",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
        "clean": "pnpm -r --if-present clean"
    },
    "devDependencies": {
        "@eslint/css": "^1.4.0",
        "@rolldown/plugin-babel": "0.2.3",
        "@types/node": "^26.1.1",
        "babel-plugin-react-compiler": "1.0.0",
        "concurrently": "^10.0.3",
        "oxfmt": "^0.57.0",
        "oxlint": "^1.73.0",
        "portless": "^0.15.4",
        "tsx": "^4.21.0",
        "typescript": "^7.0.2",
        "vite-plugin-node-polyfills": "^0.28.0"
    },
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=10.28.1"
    },
    "packageManager": "pnpm@10.28.1"
}