{
    "name": "happy-desktop-gym",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./sources/index.ts",
        "./playwright": "./sources/playwright/index.ts"
    },
    "scripts": {
        "test": "pnpm test:playwright",
        "test:playwright": "node ../../scripts/run-ui-alignment-tests.mjs --config vitest.playwright.config.ts",
        "test:playwright:artifacts": "VITE_HAPPY_DESKTOP_WRITE_SCREENSHOTS=1 node ../../scripts/run-ui-alignment-tests.mjs --config vitest.playwright.config.ts",
        "test:watch": "vitest --config vitest.playwright.config.ts",
        "typecheck": "tsc --project tsconfig.json",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint ."
    },
    "devDependencies": {
        "@fontsource-variable/jetbrains-mono": "^5.2.8",
        "@types/node": "^26.1.1",
        "@vitest/browser-playwright": "^4.1.10",
        "oxfmt": "^0.57.0",
        "oxlint": "^1.73.0",
        "playwright": "^1.61.1",
        "typescript": "^7.0.2",
        "vite": "^8.1.4",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=22.16.0"
    }
}
